{
  "name": "@iniesta8888/agent-live-dsh",
  "version": "0.3.4",
  "description": "Agent Live native conversation view for DeepSeek Harness",
  "keywords": ["dsh-plugin", "deepseek-harness", "coding-agent", "agent-live", "pixel-office"],
  "author": "ssssnail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssssnail/agent-live.git",
    "directory": "plugins/agent-live/dsh"
  },
  "homepage": "https://github.com/ssssnail/agent-live#readme",
  "bugs": {
    "url": "https://github.com/ssssnail/agent-live/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/dsh/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/dsh/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/dsh/src/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/content/**/*.json",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
		"build": "node clean.mjs && tsc --emitDeclarationOnly && node build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node scripts/validate-frame.mjs && node scripts/validate-package-content.mjs && npm pack --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
	"@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1",
	"@deepseek-ai/dsh-commands": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.1",
	"@deepseek-ai/dsh-skill": "^0.1.5-rc.1",
	"@deepseek-ai/dsh-session-projection": "^0.1.5-rc.1",
	"@deepseek-ai/dsh-session": "^0.1.5-rc.1",
	"@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
	"@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "react": "^18.2.0",
	"zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
	"@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.1",
	"@deepseek-ai/dsh-commands": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.1",
	"@deepseek-ai/dsh-skill": "0.1.5-rc.1",
	"@deepseek-ai/dsh-session-projection": "0.1.5-rc.1",
	"@deepseek-ai/dsh-session": "0.1.5-rc.1",
	"@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
	"@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/react": "^18.3.0",
	"@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.8.0",
	"zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
