{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "plugins/agent-live/src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"]
	},
	"include": [
		"plugins/agent-live/src/index.ts",
		"plugins/agent-live/src/core/**/*.ts",
		"plugins/agent-live/src/content/**/*.ts",
		"plugins/agent-live/src/creator/**/*.ts",
		"plugins/agent-live/src/runtime/**/*.ts",
		"plugins/agent-live/src/adapter-sdk/**/*.ts"
	],
	"exclude": ["plugins/agent-live/src/adapters/**/*"]
}
