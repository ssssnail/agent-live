{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"index.ts",
		"pi.ts",
		"plugins/agent-live/src/**/*.ts",
		"plugins/agent-live/scripts/**/*.ts",
		"plugins/agent-live/types/**/*.d.ts"
	],
	"exclude": ["plugins/agent-live/dsh/**"]
}
